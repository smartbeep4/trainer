    "@radix-ui/react-progress": "^1.1.0",
    "astro": "^5.16.8",
    "canvas-confetti": "^1.9.0",
    "fuse.js": "^7.0.0",
    "lucide-react": "^0.447.0",
    "mermaid": "^10.9.0",
