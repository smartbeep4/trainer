---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found">
  <section class="flex min-h-[60vh] items-center justify-center px-4 py-16">
    <div class="text-center">
      <div class="mx-auto flex h-24 w-24 items-center justify-center rounded-full bg-neutral-100 text-neutral-400 dark:bg-dark-surface dark:text-neutral-600">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-12 w-12"
        >
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
          <path d="M11 8v6" />
        </svg>
      </div>

      <h1 class="mt-6 text-3xl font-bold text-neutral-900 dark:text-neutral-100">
        Page Not Found
      </h1>

      <p class="mt-4 max-w-md text-neutral-600 dark:text-neutral-400">
        The lesson you're looking for doesn't exist. It may have been moved or renamed.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/" class="btn-primary">
          Go to Homepage
        </a>
        <a href="/#syllabus" class="btn-secondary">
          Browse Syllabus
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
