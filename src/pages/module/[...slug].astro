---
import { getCollection } from "astro:content";
import LessonLayout from "@layouts/LessonLayout.astro";
import { getModuleBySlug } from "@/lib/course-data";
import { calculateReadingTime } from "@/lib/reading-time";

export async function getStaticPaths() {
  const modules = await getCollection("modules");
  return modules.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

// Get module data from course-data for navigation
const moduleData = getModuleBySlug(entry.slug);

if (!moduleData) {
  return Astro.redirect("/404");
}

// Calculate reading time from content word count
// The raw body content is available from the entry
const rawBody = entry.body || "";
const wordCount = rawBody.split(/\s+/).filter(Boolean).length;
const readingTime = entry.data.readingTime || calculateReadingTime(wordCount);
const exerciseTime = entry.data.exerciseTime || "30-45 min exercise";
---

<LessonLayout
  title={entry.data.title}
  description={entry.data.description}
  module={moduleData}
  headings={headings}
  readingTime={readingTime}
  exerciseTime={exerciseTime}
>
  <Content />
</LessonLayout>
