---
import BaseLayout from "@layouts/BaseLayout.astro";
import ProgressTracker from "@components/react/ProgressTracker";
import { parts } from "@/lib/course-data";
---

<BaseLayout title="My Progress">
  <section class="px-4 py-12">
    <div class="mx-auto max-w-screen-xl">
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
          My Progress
        </h1>
        <p class="mt-2 text-neutral-600 dark:text-neutral-400">
          Track your learning journey through the course
        </p>
      </div>

      <div class="grid gap-8 lg:grid-cols-3">
        <!-- Main progress tracker -->
        <div class="lg:col-span-2">
          <ProgressTracker client:load variant="dashboard" />

          <!-- Part progress cards -->
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {parts.map((part) => (
              <div class="card">
                <div class="flex items-center justify-between">
                  <h3 class="font-semibold text-neutral-900 dark:text-neutral-100">
                    Part {part.number}: {part.title}
                  </h3>
                  <span class="badge-primary">{part.modules.length} modules</span>
                </div>
                <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
                  {part.description}
                </p>
                <div class="mt-4">
                  <div class="progress-bar">
                    <div
                      class="progress-bar-fill"
                      style="width: 0%"
                      data-part-progress={part.number}
                    ></div>
                  </div>
                  <div class="mt-1 text-xs text-neutral-500 dark:text-neutral-500" data-part-text={part.number}>
                    0 of {part.modules.length} modules completed
                  </div>
                </div>
                <a
                  href={`/#part-${part.number}`}
                  class="mt-4 inline-flex items-center text-sm font-medium text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300"
                >
                  View modules
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1 h-4 w-4">
                    <path d="m9 18 6-6-6-6" />
                  </svg>
                </a>
              </div>
            ))}
          </div>
        </div>

        <!-- Sidebar with recent activity -->
        <div class="space-y-6">
          <div class="card">
            <h3 class="font-semibold text-neutral-900 dark:text-neutral-100">
              Continue Learning
            </h3>
            <div class="mt-4" id="continue-learning">
              <a
                href="/module/developer-mental-model"
                class="flex items-center gap-3 rounded-lg border border-neutral-200 p-3 transition-colors hover:border-primary-300 dark:border-dark-border dark:hover:border-primary-600"
              >
                <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-primary-100 text-primary-600 dark:bg-primary-900/30 dark:text-primary-400">
                  1
                </div>
                <div class="min-w-0">
                  <div class="truncate font-medium text-neutral-900 dark:text-neutral-100">
                    The Developer's Mental Model for AI
                  </div>
                  <div class="text-xs text-neutral-500 dark:text-neutral-500">
                    Module 1 | Part 1
                  </div>
                </div>
              </a>
            </div>
          </div>

          <div class="card">
            <h3 class="font-semibold text-neutral-900 dark:text-neutral-100">
              Quick Actions
            </h3>
            <div class="mt-4 space-y-2">
              <a
                href="/"
                class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900 dark:text-neutral-400 dark:hover:bg-dark-elevated dark:hover:text-neutral-100"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                  <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                  <polyline points="9 22 9 12 15 12 15 22" />
                </svg>
                Back to Course Home
              </a>
              <button
                type="button"
                id="reset-progress-btn"
                class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm text-red-600 transition-colors hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-900/10"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                  <path d="M3 6h18" />
                  <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                  <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                </svg>
                Reset Progress
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { getProgress, resetProgress } from "@/lib/progress";
  import { parts } from "@/lib/course-data";

  function updatePartProgress() {
    const progress = getProgress();

    parts.forEach((part) => {
      const partModules = part.modules.map((m) => m.slug);
      const completedInPart = progress.completedModules.filter((slug) =>
        partModules.includes(slug)
      ).length;
      const percentage = Math.round((completedInPart / part.modules.length) * 100);

      const progressBar = document.querySelector(`[data-part-progress="${part.number}"]`) as HTMLElement;
      const progressText = document.querySelector(`[data-part-text="${part.number}"]`);

      if (progressBar) {
        progressBar.style.width = `${percentage}%`;
      }
      if (progressText) {
        progressText.textContent = `${completedInPart} of ${part.modules.length} modules completed`;
      }
    });
  }

  function initResetButton() {
    const btn = document.getElementById("reset-progress-btn");
    if (btn) {
      btn.addEventListener("click", () => {
        if (confirm("Are you sure you want to reset all progress? This cannot be undone.")) {
          resetProgress();
          window.location.reload();
        }
      });
    }
  }

  // Initialize
  document.addEventListener("DOMContentLoaded", () => {
    updatePartProgress();
    initResetButton();
  });
  if (document.readyState !== "loading") {
    updatePartProgress();
    initResetButton();
  }
</script>
