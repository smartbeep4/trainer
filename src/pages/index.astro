---
import BaseLayout from "@layouts/BaseLayout.astro";
import { parts, courseStats } from "@/lib/course-data";
import ProgressTracker from "@components/react/ProgressTracker";
---

<BaseLayout title="Developer of Tomorrow">
  <!-- Hero Section -->
  <section
    class="relative overflow-hidden bg-gradient-to-b from-primary-50 to-white px-4 py-16 dark:from-dark-surface dark:to-dark-bg lg:py-24"
  >
    <div class="mx-auto max-w-screen-xl">
      <div class="mx-auto max-w-3xl text-center">
        <h1
          class="text-4xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 lg:text-5xl"
        >
          Developer of Tomorrow
        </h1>
        <p
          class="mt-4 text-xl text-neutral-600 dark:text-neutral-400 lg:text-2xl"
        >
          Mastering AI in Your Technical Workflow
        </p>
        <p class="mt-6 text-lg text-neutral-600 dark:text-neutral-400">
          A free, interactive course teaching technical professionals how to
          effectively integrate AI into their daily workflows.
        </p>

        <div
          class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row"
        >
          <a
            href="/module/developer-mental-model"
            class="btn-primary inline-flex items-center gap-2 px-6 py-3 text-lg"
          >
            Start Learning
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
            >
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
          <a
            href="#syllabus"
            class="btn-secondary inline-flex items-center gap-2 px-6 py-3 text-lg"
          >
            View Syllabus
          </a>
        </div>
      </div>
    </div>

    <!-- Decorative background elements -->
    <div
      class="absolute -right-40 -top-40 h-80 w-80 rounded-full bg-primary-100 opacity-50 blur-3xl dark:bg-primary-900/20"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute -bottom-40 -left-40 h-80 w-80 rounded-full bg-accent-100 opacity-50 blur-3xl dark:bg-accent-900/20"
      aria-hidden="true"
    >
    </div>
  </section>

  <!-- Course Stats -->
  <section
    class="border-y border-neutral-200 bg-neutral-50 px-4 py-8 dark:border-dark-border dark:bg-dark-surface"
  >
    <div class="mx-auto max-w-screen-xl">
      <div class="flex flex-wrap items-center justify-center gap-8 lg:gap-16">
        <div class="text-center">
          <div
            class="text-3xl font-bold text-primary-600 dark:text-primary-400"
          >
            {courseStats.totalModules}
          </div>
          <div class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
            Modules
          </div>
        </div>
        <div class="text-center">
          <div
            class="text-3xl font-bold text-primary-600 dark:text-primary-400"
          >
            {courseStats.totalHours}
          </div>
          <div class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
            Of Content
          </div>
        </div>
        <div class="text-center">
          <div
            class="text-3xl font-bold text-primary-600 dark:text-primary-400"
          >
            {courseStats.parts}
          </div>
          <div class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
            Learning Paths
          </div>
        </div>
        <div class="text-center">
          <div
            class="text-3xl font-bold text-success-600 dark:text-success-400"
          >
            Free
          </div>
          <div class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
            Forever
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Your Progress (client-side) -->
  <section class="px-4 py-12">
    <div class="mx-auto max-w-screen-xl">
      <div class="mx-auto max-w-md">
        <ProgressTracker client:load variant="dashboard" />
      </div>
    </div>
  </section>

  <!-- Course Syllabus -->
  <section id="syllabus" class="scroll-mt-20 px-4 py-12">
    <div class="mx-auto max-w-screen-xl">
      <div class="mb-12 text-center">
        <h2 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
          Course Syllabus
        </h2>
        <p class="mt-4 text-lg text-neutral-600 dark:text-neutral-400">
          Structured learning from foundations to advanced AI integration
        </p>
      </div>

      <div class="space-y-12">
        {
          parts.map((part) => (
            <div id={`part-${part.number}`} class="scroll-mt-20">
              {/* Part Header */}
              <div class="mb-6 flex items-center gap-4">
                <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-primary-100 text-lg font-bold text-primary-600 dark:bg-primary-900/30 dark:text-primary-400">
                  {part.number}
                </div>
                <div>
                  <h3 class="text-xl font-semibold text-neutral-900 dark:text-neutral-100">
                    Part {part.number}: {part.title}
                  </h3>
                  <p class="text-sm text-neutral-600 dark:text-neutral-400">
                    {part.description} | {part.duration}
                  </p>
                </div>
              </div>

              {/* Modules Grid */}
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {part.modules.map((module) => (
                  <a href={`/module/${module.slug}`} class="card-hover group">
                    <div class="flex items-start gap-3">
                      <div class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-neutral-100 text-sm font-medium text-neutral-600 group-hover:bg-primary-100 group-hover:text-primary-600 dark:bg-dark-elevated dark:text-neutral-400 dark:group-hover:bg-primary-900/30 dark:group-hover:text-primary-400">
                        {module.id}
                      </div>
                      <div class="min-w-0 flex-1">
                        <h4 class="font-medium text-neutral-900 group-hover:text-primary-600 dark:text-neutral-100 dark:group-hover:text-primary-400">
                          {module.title}
                        </h4>
                        <p class="mt-1 line-clamp-2 text-sm text-neutral-600 dark:text-neutral-400">
                          {module.description}
                        </p>
                        <div class="mt-2 flex items-center gap-3 text-xs text-neutral-500 dark:text-neutral-500">
                          <span>{module.duration}</span>
                          <span class="badge-primary">{module.difficulty}</span>
                        </div>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Target Audience -->
  <section
    class="border-t border-neutral-200 bg-neutral-50 px-4 py-16 dark:border-dark-border dark:bg-dark-surface"
  >
    <div class="mx-auto max-w-screen-xl">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
          Who Is This For?
        </h2>
        <p class="mt-4 text-lg text-neutral-600 dark:text-neutral-400">
          Technical professionals ready to integrate AI into their workflow
        </p>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-3">
        <div class="text-center">
          <div
            class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-primary-100 text-primary-600 dark:bg-primary-900/30 dark:text-primary-400"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-8 w-8"
            >
              <path
                d="M18 16.98h-5.99c-1.1 0-1.95.94-2.48 1.9A4 4 0 0 1 2 17c.01-.7.2-1.4.57-2"
              ></path>
              <path
                d="m6 17 3.13-5.78c.53-.97.1-2.18-.5-3.1a4 4 0 1 1 6.89-4.06"
              ></path>
              <path
                d="m12 6 3.13 5.73C15.66 12.7 16.9 13 18 13a4 4 0 0 1 .64 7.95"
              ></path>
            </svg>
          </div>
          <h3
            class="mt-4 text-lg font-semibold text-neutral-900 dark:text-neutral-100"
          >
            Software Engineers
          </h3>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            Level up your coding with AI assistance while understanding the
            underlying technology
          </p>
        </div>

        <div class="text-center">
          <div
            class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-accent-100 text-accent-600 dark:bg-accent-900/30 dark:text-accent-400"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-8 w-8"
            >
              <path d="M3 3v16a2 2 0 0 0 2 2h16"></path>
              <path d="m19 9-5 5-4-4-3 3"></path>
            </svg>
          </div>
          <h3
            class="mt-4 text-lg font-semibold text-neutral-900 dark:text-neutral-100"
          >
            Data Analysts
          </h3>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            Enhance your analysis capabilities with AI-powered tools and
            techniques
          </p>
        </div>

        <div class="text-center">
          <div
            class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-success-100 text-success-600 dark:bg-success-900/30 dark:text-success-400"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-8 w-8"
            >
              <path d="M12 2v4"></path>
              <path d="m6.8 14-3.5 2"></path>
              <path d="m20.7 16-3.5-2"></path>
              <path d="M6.8 10 3.3 8"></path>
              <path d="m20.7 8-3.5 2"></path>
              <path d="m9 22 3-8 3 8"></path>
              <path d="M8 22h8"></path>
              <path d="M12 2a4 4 0 0 0-4 4v4a4 4 0 0 0 8 0V6a4 4 0 0 0-4-4Z"
              ></path>
            </svg>
          </div>
          <h3
            class="mt-4 text-lg font-semibold text-neutral-900 dark:text-neutral-100"
          >
            Technical Leaders
          </h3>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            Understand AI to make informed decisions about adoption and
            integration
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What You'll Learn -->
  <section class="px-4 py-16">
    <div class="mx-auto max-w-screen-xl">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
          What You'll Learn
        </h2>
        <p class="mt-4 text-lg text-neutral-600 dark:text-neutral-400">
          Practical skills from fundamentals to advanced AI integration
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <div class="card">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary-100 text-primary-600 dark:bg-primary-900/30 dark:text-primary-400"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 16v-4"></path>
              <path d="M12 8h.01"></path>
            </svg>
          </div>
          <h3 class="mt-4 font-semibold text-neutral-900 dark:text-neutral-100">
            Deep Understanding
          </h3>
          <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
            How transformers actually work, why they succeed and fail
          </p>
        </div>

        <div class="card">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent-100 text-accent-600 dark:bg-accent-900/30 dark:text-accent-400"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
            >
              <path d="m18 16 4-4-4-4"></path>
              <path d="m6 8-4 4 4 4"></path>
              <path d="m14.5 4-5 16"></path>
            </svg>
          </div>
          <h3 class="mt-4 font-semibold text-neutral-900 dark:text-neutral-100">
            Practical Skills
          </h3>
          <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
            Prompt engineering, API integration, agent building
          </p>
        </div>

        <div class="card">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-lg bg-success-100 text-success-600 dark:bg-success-900/30 dark:text-success-400"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
            >
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </div>
          <h3 class="mt-4 font-semibold text-neutral-900 dark:text-neutral-100">
            Safety Awareness
          </h3>
          <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
            Real risks, responsible practices, organizational considerations
          </p>
        </div>

        <div class="card">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-lg bg-warning-100 text-warning-600 dark:bg-warning-900/30 dark:text-warning-400"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
            >
              <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </div>
          <h3 class="mt-4 font-semibold text-neutral-900 dark:text-neutral-100">
            Critical Judgment
          </h3>
          <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
            When to use AI, when not to, and how to evaluate outputs
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section
    class="border-t border-neutral-200 bg-gradient-to-b from-primary-50 to-white px-4 py-16 dark:border-dark-border dark:from-dark-surface dark:to-dark-bg"
  >
    <div class="mx-auto max-w-screen-xl text-center">
      <h2 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
        Ready to Begin?
      </h2>
      <p class="mt-4 text-lg text-neutral-600 dark:text-neutral-400">
        Start your journey to becoming an AI-fluent technical professional
      </p>
      <a
        href="/module/developer-mental-model"
        class="btn-primary mt-8 inline-flex items-center gap-2 px-8 py-4 text-lg"
      >
        Start Module 1
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-5 w-5"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
