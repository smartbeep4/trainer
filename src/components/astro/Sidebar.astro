---
import { parts, type Module } from "@/lib/course-data";

interface Props {
  currentModuleSlug?: string;
}

const { currentModuleSlug } = Astro.props;

function getModuleStatus(module: Module, currentSlug?: string): "current" | "completed" | "upcoming" {
  if (module.slug === currentSlug) {
    return "current";
  }
  // In a real app, this would check localStorage via client-side JS
  // For SSR, we'll mark all as upcoming and let client-side hydration update
  return "upcoming";
}
---

<nav class="space-y-6" aria-label="Course navigation">
  <!-- Progress summary placeholder -->
  <div class="rounded-lg border border-neutral-200 bg-white p-4 dark:border-dark-border dark:bg-dark-surface">
    <div class="text-sm font-medium text-neutral-600 dark:text-neutral-400">
      Course Progress
    </div>
    <div class="mt-2">
      <div class="progress-bar">
        <div
          class="progress-bar-fill"
          style="width: 0%"
          id="sidebar-progress-bar"
        ></div>
      </div>
      <div class="mt-1 text-xs text-neutral-500 dark:text-neutral-500" id="sidebar-progress-text">
        0 of 23 modules completed
      </div>
    </div>
  </div>

  <!-- Parts and modules -->
  {parts.map((part) => (
    <div class="space-y-2">
      <button
        type="button"
        class="flex w-full items-center justify-between rounded-lg px-2 py-1.5 text-sm font-semibold text-neutral-900 hover:bg-neutral-100 dark:text-neutral-100 dark:hover:bg-dark-elevated"
        aria-expanded="true"
        data-part={part.number}
      >
        <span>Part {part.number}: {part.title}</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-4 w-4 transition-transform"
        >
          <path d="m6 9 6 6 6-6" />
        </svg>
      </button>

      <ul class="ml-2 space-y-1 border-l border-neutral-200 pl-3 dark:border-dark-border">
        {part.modules.map((module) => {
          const status = getModuleStatus(module, currentModuleSlug);
          const isCurrent = status === "current";

          return (
            <li>
              <a
                href={`/module/${module.slug}`}
                class:list={[
                  "flex items-center gap-2 rounded-md px-2 py-1.5 text-sm transition-colors",
                  {
                    "bg-primary-50 font-medium text-primary-700 dark:bg-primary-900/20 dark:text-primary-300": isCurrent,
                    "text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900 dark:text-neutral-400 dark:hover:bg-dark-elevated dark:hover:text-neutral-100": !isCurrent,
                  },
                ]}
                aria-current={isCurrent ? "page" : undefined}
              >
                <!-- Status icon -->
                <span class="flex h-5 w-5 flex-shrink-0 items-center justify-center">
                  {status === "completed" ? (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="h-4 w-4 text-success-500"
                    >
                      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                      <path d="m9 11 3 3L22 4" />
                    </svg>
                  ) : isCurrent ? (
                    <span class="h-2 w-2 rounded-full bg-primary-500"></span>
                  ) : (
                    <span class="h-2 w-2 rounded-full border-2 border-neutral-300 dark:border-neutral-600"></span>
                  )}
                </span>

                <!-- Module title -->
                <span class="line-clamp-2">
                  {module.id}. {module.title}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</nav>

<script>
  // Client-side script to update sidebar with progress from localStorage
  import { getProgress, getCompletionPercentage } from "@/lib/progress";

  function updateSidebarProgress() {
    const progress = getProgress();
    const percentage = getCompletionPercentage(23);

    const progressBar = document.getElementById("sidebar-progress-bar");
    const progressText = document.getElementById("sidebar-progress-text");

    if (progressBar) {
      progressBar.style.width = `${percentage}%`;
    }

    if (progressText) {
      progressText.textContent = `${progress.completedModules.length} of 23 modules completed`;
    }

    // Update module status icons
    progress.completedModules.forEach((slug) => {
      const link = document.querySelector(`a[href="/module/${slug}"]`);
      if (link) {
        const iconSpan = link.querySelector("span:first-child");
        if (iconSpan) {
          iconSpan.innerHTML = `
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4 text-success-500"
            >
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
              <path d="m9 11 3 3L22 4" />
            </svg>
          `;
        }
      }
    });
  }

  // Run on page load
  document.addEventListener("DOMContentLoaded", updateSidebarProgress);
  // Also run immediately in case DOMContentLoaded already fired
  if (document.readyState !== "loading") {
    updateSidebarProgress();
  }
</script>
