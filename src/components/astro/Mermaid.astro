---
interface Props {
  chart: string;
}

const { chart } = Astro.props;
---

<div class="mermaid-wrapper my-6">
  <pre class="mermaid">{chart}</pre>
</div>

<script>
  import mermaid from "mermaid";

  // Initialize Mermaid with theme support
  function initMermaid() {
    const isDark = document.documentElement.classList.contains("dark");

    mermaid.initialize({
      startOnLoad: true,
      theme: isDark ? "dark" : "default",
      securityLevel: "loose",
      fontFamily: "Inter Variable, Inter, system-ui, sans-serif",
      flowchart: {
        curve: "basis",
        padding: 20,
      },
      themeVariables: isDark
        ? {
            primaryColor: "#3b82f6",
            primaryTextColor: "#fff",
            primaryBorderColor: "#1d4ed8",
            lineColor: "#6b7280",
            secondaryColor: "#27272a",
            tertiaryColor: "#18181b",
            background: "#0f0f10",
            mainBkg: "#18181b",
            nodeBorder: "#3f3f46",
            clusterBkg: "#27272a",
            clusterBorder: "#3f3f46",
            titleColor: "#f5f5f5",
            edgeLabelBackground: "#27272a",
          }
        : {
            primaryColor: "#3b82f6",
            primaryTextColor: "#fff",
            primaryBorderColor: "#2563eb",
            lineColor: "#6b7280",
            secondaryColor: "#f3f4f6",
            tertiaryColor: "#ffffff",
          },
    });

    // Re-render all diagrams
    mermaid.run();
  }

  // Initial render
  document.addEventListener("DOMContentLoaded", initMermaid);
  if (document.readyState !== "loading") {
    initMermaid();
  }

  // Re-render on theme change
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.attributeName === "class") {
        // Clear and re-render all mermaid diagrams
        document.querySelectorAll(".mermaid").forEach((el) => {
          el.removeAttribute("data-processed");
        });
        initMermaid();
      }
    });
  });

  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["class"],
  });

  // Re-initialize on Astro page transitions
  document.addEventListener("astro:after-swap", initMermaid);
</script>

<style>
  .mermaid-wrapper {
    @apply flex justify-center overflow-x-auto;
  }

  .mermaid {
    @apply max-w-full;
  }

  .mermaid svg {
    @apply max-w-full;
  }
</style>
