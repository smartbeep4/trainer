---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

// Only include h2 and h3 headings
const filteredHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{filteredHeadings.length > 0 && (
  <div class="rounded-lg border border-neutral-200 bg-white dark:border-dark-border dark:bg-dark-surface">
    <!-- Module Progress Indicator -->
    <div class="flex items-center gap-3 px-4 py-3 border-b border-neutral-200 dark:border-dark-border">
      <div class="relative h-8 w-8 flex-shrink-0" id="progress-pie">
        <svg class="h-full w-full -rotate-90" viewBox="0 0 32 32">
          <!-- Background circle -->
          <circle
            cx="16"
            cy="16"
            r="14"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            class="text-neutral-200 dark:text-dark-elevated"
          />
          <!-- Progress arc -->
          <circle
            cx="16"
            cy="16"
            r="14"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-dasharray="0 88"
            id="progress-arc"
            class="text-primary-500 transition-all duration-300"
          />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">
          On this page
        </span>
        <span class="text-xs text-neutral-500 dark:text-neutral-400" id="progress-text">
          0% complete
        </span>
      </div>
    </div>
    <nav
      aria-label="Table of contents"
      id="toc-nav"
      class="max-h-[calc(100vh-12rem)] overflow-y-auto scroll-smooth"
    >
      <ul class="space-y-1 p-2 text-sm">
        {filteredHeadings.map((heading, index) => (
          <li data-toc-item={index}>
            <a
              href={`#${heading.slug}`}
              class:list={[
                "block rounded-md px-3 py-2 transition-all duration-200",
                "text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900",
                "dark:text-neutral-300 dark:hover:bg-dark-elevated dark:hover:text-neutral-100",
                heading.depth === 3 && "ml-3",
              ]}
              data-toc-link
              data-heading-slug={heading.slug}
              data-toc-index={index}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
)}

<script>
  // Scroll spy to highlight current section and auto-scroll TOC
  function initScrollSpy() {
    const links = document.querySelectorAll("[data-toc-link]");
    const tocNav = document.getElementById("toc-nav");
    const progressArc = document.getElementById("progress-arc");
    const progressText = document.getElementById("progress-text");
    if (links.length === 0 || !tocNav) return;

    // Progress tracking
    const circumference = 2 * Math.PI * 14; // r=14
    let lastScrollPercent = 0;

    function updateProgress() {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const scrollPercent = Math.min(100, Math.round((scrollTop / docHeight) * 100));

      if (scrollPercent !== lastScrollPercent) {
        lastScrollPercent = scrollPercent;

        if (progressArc) {
          const dashLength = (scrollPercent / 100) * circumference;
          progressArc.setAttribute("stroke-dasharray", `${dashLength} ${circumference}`);
        }

        if (progressText) {
          progressText.textContent = `${scrollPercent}% complete`;
        }
      }
    }

    // Throttled scroll handler for progress
    let ticking = false;
    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateProgress();
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    updateProgress(); // Initial call

    const headingElements = Array.from(links).map((link) => {
      const slug = link.getAttribute("data-heading-slug");
      return document.getElementById(slug || "");
    }).filter(Boolean) as HTMLElement[];

    if (headingElements.length === 0) return;

    // Active styles
    const activeClasses = [
      "bg-primary-50",
      "text-primary-700",
      "font-medium",
      "dark:bg-primary-900/30",
      "dark:text-primary-300",
    ];

    const inactiveClasses = [
      "text-neutral-600",
      "dark:text-neutral-300",
    ];

    let currentActiveIndex = -1;

    function setActiveLink(link: Element | null, index: number) {
      if (!link || currentActiveIndex === index) return;

      // Remove active class from all links
      links.forEach((l) => {
        activeClasses.forEach(cls => l.classList.remove(cls));
        inactiveClasses.forEach(cls => l.classList.add(cls));
      });

      // Add active class to current link
      inactiveClasses.forEach(cls => link.classList.remove(cls));
      activeClasses.forEach(cls => link.classList.add(cls));

      currentActiveIndex = index;

      // Auto-scroll TOC to keep active item visible with max 4 items above
      const tocItem = link.closest("[data-toc-item]") as HTMLElement;
      if (tocItem && tocNav) {
        const itemTop = tocItem.offsetTop;
        const itemHeight = tocItem.offsetHeight;
        const navScrollTop = tocNav.scrollTop;
        const navHeight = tocNav.clientHeight;

        // Calculate target scroll position (keep max 4 items above)
        // Each item is roughly 40px (py-2 + text)
        const maxItemsAbove = 4;
        const targetScrollTop = Math.max(0, itemTop - (maxItemsAbove * itemHeight));

        // Only scroll if item is out of comfortable view range
        const itemBottom = itemTop + itemHeight;
        const visibleTop = navScrollTop;
        const visibleBottom = navScrollTop + navHeight;

        // If item is too high or too low, scroll to show it with max 4 above
        if (itemTop < visibleTop + (maxItemsAbove * itemHeight) - (2 * itemHeight) ||
            itemBottom > visibleBottom - itemHeight) {
          tocNav.scrollTo({
            top: targetScrollTop,
            behavior: "smooth"
          });
        }
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        // Find the topmost visible heading
        let topmostEntry: IntersectionObserverEntry | null = null;
        let topmostY = Infinity;

        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const rect = entry.boundingClientRect;
            if (rect.top < topmostY && rect.top > -100) {
              topmostY = rect.top;
              topmostEntry = entry;
            }
          }
        });

        if (topmostEntry) {
          const link = document.querySelector(
            `[data-heading-slug="${(topmostEntry as IntersectionObserverEntry).target.id}"]`
          );
          const index = parseInt(link?.getAttribute("data-toc-index") || "-1");
          setActiveLink(link, index);
        }
      },
      {
        rootMargin: "-80px 0px -60% 0px",
        threshold: [0, 0.5, 1],
      }
    );

    headingElements.forEach((el) => observer.observe(el));

    // Handle click smooth scrolling
    links.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const slug = link.getAttribute("data-heading-slug");
        const target = document.getElementById(slug || "");
        if (target) {
          target.scrollIntoView({ behavior: "smooth", block: "start" });
          // Update URL hash without jumping
          history.pushState(null, "", `#${slug}`);
        }
      });
    });

    // Cleanup on navigation
    document.addEventListener("astro:before-swap", () => {
      observer.disconnect();
      window.removeEventListener("scroll", onScroll);
    }, { once: true });
  }

  // Initialize on page load
  document.addEventListener("DOMContentLoaded", initScrollSpy);
  if (document.readyState !== "loading") {
    initScrollSpy();
  }

  // Re-initialize on Astro page transitions
  document.addEventListener("astro:after-swap", initScrollSpy);
</script>
