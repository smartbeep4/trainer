---
const currentYear = new Date().getFullYear();
---

<footer
  class="mt-auto border-t border-neutral-200 bg-neutral-50 dark:border-dark-border dark:bg-dark-surface"
>
  <div class="mx-auto max-w-screen-2xl px-4 py-8 lg:px-8">
    <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
      <!-- Copyright -->
      <div
        class="flex items-center gap-2 text-sm text-neutral-600 dark:text-neutral-400"
      >
        <span>&copy; {currentYear} Developer of Tomorrow.</span>
        <span class="hidden sm:inline">All rights reserved.</span>
      </div>

      <!-- Links -->
      <div class="flex items-center gap-4 text-sm">
        <a
          href="/about"
          class="text-neutral-600 transition-colors hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
        >
          About
        </a>
        <a
          href="https://github.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-neutral-600 transition-colors hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
        >
          GitHub
        </a>
        <a
          href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-neutral-600 transition-colors hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
        >
          CC BY-NC-SA 4.0
        </a>
      </div>
    </div>

    <!-- Attribution -->
    <div
      class="mt-4 text-center text-xs text-neutral-500 dark:text-neutral-500"
    >
      Built with care for the developer community. Powered by Astro.
    </div>
  </div>
</footer>
