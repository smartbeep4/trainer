---
import { getNextModule, getPreviousModule } from "@/lib/course-data";

interface Props {
  currentModuleId: number;
}

const { currentModuleId } = Astro.props;

const previousModule = getPreviousModule(currentModuleId);
const nextModule = getNextModule(currentModuleId);
---

<nav
  class="mt-12 flex flex-col gap-4 border-t border-neutral-200 pt-8 dark:border-dark-border sm:flex-row sm:justify-between"
  aria-label="Lesson navigation"
>
  <!-- Previous module -->
  <div class="flex-1">
    {
      previousModule ? (
        <a
          href={`/module/${previousModule.slug}`}
          class="group flex items-center gap-3 rounded-lg border border-neutral-200 p-4 transition-all hover:border-primary-300 hover:shadow-sm dark:border-dark-border dark:hover:border-primary-600"
        >
          <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-neutral-100 text-neutral-600 transition-colors group-hover:bg-primary-100 group-hover:text-primary-600 dark:bg-dark-elevated dark:text-neutral-400 dark:group-hover:bg-primary-900/30 dark:group-hover:text-primary-400">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
            >
              <path d="m15 18-6-6 6-6" />
            </svg>
          </div>
          <div class="min-w-0">
            <div class="text-xs font-medium text-neutral-500 dark:text-neutral-500">
              Previous
            </div>
            <div class="mt-0.5 truncate font-medium text-neutral-900 dark:text-neutral-100">
              {previousModule.title}
            </div>
          </div>
        </a>
      ) : (
        <div />
      )
    }
  </div>

  <!-- Mark complete button -->
  <div class="flex items-center justify-center sm:px-4">
    <button
      type="button"
      id="mark-complete-btn"
      data-module-slug={Astro.props.currentModuleId}
      class="btn-primary flex items-center gap-2"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-5 w-5"
        id="mark-complete-icon"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <path d="m9 12 2 2 4-4"></path>
      </svg>
      <span id="mark-complete-text">Mark Complete</span>
    </button>
  </div>

  <!-- Next module -->
  <div class="flex-1">
    {
      nextModule ? (
        <a
          href={`/module/${nextModule.slug}`}
          class="group flex items-center justify-end gap-3 rounded-lg border border-neutral-200 p-4 transition-all hover:border-primary-300 hover:shadow-sm dark:border-dark-border dark:hover:border-primary-600"
        >
          <div class="min-w-0 text-right">
            <div class="text-xs font-medium text-neutral-500 dark:text-neutral-500">
              Next
            </div>
            <div class="mt-0.5 truncate font-medium text-neutral-900 dark:text-neutral-100">
              {nextModule.title}
            </div>
          </div>
          <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-neutral-100 text-neutral-600 transition-colors group-hover:bg-primary-100 group-hover:text-primary-600 dark:bg-dark-elevated dark:text-neutral-400 dark:group-hover:bg-primary-900/30 dark:group-hover:text-primary-400">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
            >
              <path d="m9 18 6-6-6-6" />
            </svg>
          </div>
        </a>
      ) : (
        <div class="flex items-center justify-end">
          <a href="/" class="btn-secondary">
            Back to Course Home
          </a>
        </div>
      )
    }
  </div>
</nav>

<script>
  import {
    markModuleComplete as saveComplete,
    isModuleComplete as checkComplete,
  } from "@/lib/progress";

  function initMarkComplete() {
    const btn = document.getElementById("mark-complete-btn");
    const icon = document.getElementById("mark-complete-icon");
    const text = document.getElementById("mark-complete-text");

    if (!btn) return;

    // Get current page module slug from URL
    const pathParts = window.location.pathname.split("/");
    const moduleSlug =
      pathParts[pathParts.length - 1] || pathParts[pathParts.length - 2];

    // Check if already completed
    function updateUI(completed: boolean) {
      if (completed && btn) {
        btn.classList.remove("btn-primary");
        btn.classList.add("btn-secondary");
        if (icon) {
          icon.innerHTML = `
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
            <path d="m9 11 3 3L22 4" />
          `;
        }
        if (text) {
          text.textContent = "Completed";
        }
      }
    }

    // Initial state
    if (checkComplete(moduleSlug)) {
      updateUI(true);
    }

    // Handle click
    btn.addEventListener("click", () => {
      saveComplete(moduleSlug);
      updateUI(true);

      // Trigger confetti animation
      if (typeof window !== "undefined" && "confetti" in window) {
        const confetti = window.confetti as (
          options: Record<string, unknown>
        ) => void;
        confetti({
          particleCount: 100,
          spread: 70,
          origin: { y: 0.6 },
        });
      }
    });
  }

  // Initialize
  document.addEventListener("DOMContentLoaded", initMarkComplete);
  if (document.readyState !== "loading") {
    initMarkComplete();
  }
  document.addEventListener("astro:after-swap", initMarkComplete);
</script>
