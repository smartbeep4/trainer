---
import BaseLayout from "./BaseLayout.astro";
import Sidebar from "@components/astro/Sidebar.astro";
import Breadcrumbs from "@components/astro/Breadcrumbs.astro";
import TableOfContents from "@components/astro/TableOfContents.astro";
import LessonNavigation from "@components/astro/LessonNavigation.astro";
import ProgressTracker from "@components/react/ProgressTracker";
import MobileTableOfContents from "@components/react/MobileTableOfContents";
import FocusModeToggle from "@components/react/FocusModeToggle";
import type { Module } from "@/lib/course-data";

interface Props {
  title: string;
  description?: string;
  module: Module;
  headings?: { depth: number; slug: string; text: string }[];
  readingTime?: string;
  exerciseTime?: string;
}

const { title, description, module, headings = [], readingTime, exerciseTime } = Astro.props;

const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: `Part ${module.part}: ${module.partTitle}`, href: `/#part-${module.part}` },
  { label: module.title, href: `/module/${module.slug}` },
];
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-screen-2xl">
    <div class="flex min-h-[calc(100vh-4rem)]">
      <!-- Sidebar (hidden on mobile) -->
      <aside data-sidebar="left" class="hidden w-72 flex-shrink-0 border-r border-neutral-200 lg:block dark:border-dark-border">
        <div class="sticky top-16 h-[calc(100vh-4rem)] overflow-y-auto p-4">
          <Sidebar currentModuleSlug={module.slug} />
        </div>
      </aside>

      <!-- Main content area -->
      <div class="flex flex-1 flex-col lg:flex-row" data-main-content>
        <!-- Content -->
        <article class="flex-1 px-4 py-8 lg:px-8">
          <div class="mx-auto max-w-3xl">
            <!-- Focus mode toggle -->
            <div class="mb-4 flex justify-end">
              <FocusModeToggle client:load />
            </div>

            <!-- Breadcrumbs -->
            <Breadcrumbs items={breadcrumbItems} />

            <!-- Lesson header -->
            <header class="mb-8 mt-4">
              <div class="flex flex-wrap items-center gap-2 text-sm text-neutral-600 dark:text-neutral-300">
                <span class="badge-primary">Module {module.id}</span>
                <span>{module.duration}</span>
                <span class="text-neutral-300 dark:text-neutral-500">|</span>
                <span>{module.difficulty}</span>
                {readingTime && (
                  <>
                    <span class="text-neutral-300 dark:text-neutral-500">|</span>
                    <span class="flex items-center gap-1">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-4 w-4"
                      >
                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                      </svg>
                      {readingTime}
                    </span>
                  </>
                )}
                {exerciseTime && (
                  <>
                    <span class="text-neutral-300 dark:text-neutral-500">|</span>
                    <span class="flex items-center gap-1">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-4 w-4"
                      >
                        <path d="m18 16 4-4-4-4" />
                        <path d="m6 8-4 4 4 4" />
                        <path d="m14.5 4-5 16" />
                      </svg>
                      {exerciseTime}
                    </span>
                  </>
                )}
              </div>
              <h1 class="mt-3 text-3xl font-bold tracking-tight text-neutral-900 lg:text-4xl dark:text-neutral-100">
                {title}
              </h1>
              {description && (
                <p class="mt-3 text-lg text-neutral-600 dark:text-neutral-300">
                  {description}
                </p>
              )}
            </header>

            <!-- Progress indicator (client-side) -->
            <div class="mb-8">
              <ProgressTracker
                client:load
                moduleSlug={module.slug}
                variant="lesson"
              />
            </div>

            <!-- Mobile Table of Contents (shown only on mobile/tablet) -->
            {headings.length > 0 && (
              <MobileTableOfContents client:load headings={headings} />
            )}

            <!-- Lesson content -->
            <div class="prose-custom">
              <slot />
            </div>

            <!-- Lesson navigation -->
            <LessonNavigation currentModuleId={module.id} />
          </div>
        </article>

        <!-- Table of Contents (hidden on mobile/tablet) -->
        {headings.length > 0 && (
          <aside data-sidebar="right" class="hidden w-64 flex-shrink-0 xl:block">
            <div class="sticky top-16 p-4">
              <TableOfContents headings={headings} />
            </div>
          </aside>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Initialize Mermaid diagrams
  import mermaid from "mermaid";

  function initMermaid() {
    const isDark = document.documentElement.classList.contains("dark");

    mermaid.initialize({
      startOnLoad: false,
      theme: isDark ? "dark" : "default",
      securityLevel: "loose",
      fontFamily: "Inter Variable, Inter, system-ui, sans-serif",
      flowchart: {
        curve: "basis",
        padding: 20,
      },
      themeVariables: isDark
        ? {
            primaryColor: "#3b82f6",
            primaryTextColor: "#fff",
            primaryBorderColor: "#1d4ed8",
            lineColor: "#6b7280",
            secondaryColor: "#27272a",
            tertiaryColor: "#18181b",
            background: "#0f0f10",
            mainBkg: "#18181b",
            nodeBorder: "#3f3f46",
            clusterBkg: "#27272a",
            clusterBorder: "#3f3f46",
            titleColor: "#f5f5f5",
            edgeLabelBackground: "#27272a",
          }
        : {
            primaryColor: "#3b82f6",
            primaryTextColor: "#fff",
            primaryBorderColor: "#2563eb",
            lineColor: "#6b7280",
          },
    });

    // Find and render mermaid code blocks
    mermaid.run({
      querySelector: ".mermaid, pre > code.language-mermaid",
    });
  }

  // Initialize on load
  document.addEventListener("DOMContentLoaded", initMermaid);
  if (document.readyState !== "loading") {
    initMermaid();
  }

  // Re-initialize on Astro page transitions
  document.addEventListener("astro:after-swap", initMermaid);

  // Re-render on theme change
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.attributeName === "class") {
        document.querySelectorAll(".mermaid, pre > code.language-mermaid").forEach((el) => {
          el.removeAttribute("data-processed");
        });
        initMermaid();
      }
    });
  });

  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["class"],
  });
</script>

<style>
  /* Custom prose overrides for lesson content */
  .prose-custom :global(h2) {
    @apply mt-10 scroll-mt-20;
  }

  .prose-custom :global(h3) {
    @apply mt-8 scroll-mt-20;
  }

  .prose-custom :global(pre) {
    @apply my-6;
  }

  .prose-custom :global(.mermaid) {
    @apply my-8;
  }
</style>
