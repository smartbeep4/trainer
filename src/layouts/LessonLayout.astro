---
import BaseLayout from "./BaseLayout.astro";
import Sidebar from "@components/astro/Sidebar.astro";
import Breadcrumbs from "@components/astro/Breadcrumbs.astro";
import TableOfContents from "@components/astro/TableOfContents.astro";
import LessonNavigation from "@components/astro/LessonNavigation.astro";
import ProgressTracker from "@components/react/ProgressTracker";
import MobileTableOfContents from "@components/react/MobileTableOfContents";
import FocusModeToggle from "@components/react/FocusModeToggle";
import ContentAnnotations from "@components/react/ContentAnnotations";
import ReadingProgress from "@components/react/ReadingProgress";
import type { Module } from "@/lib/course-data";

interface Props {
  title: string;
  description?: string;
  module: Module;
  headings?: { depth: number; slug: string; text: string }[];
  readingTime?: string;
  exerciseTime?: string;
}

const {
  title,
  description,
  module,
  headings = [],
  readingTime,
  exerciseTime,
} = Astro.props;

const breadcrumbItems = [
  { label: "Home", href: "/" },
  {
    label: `Part ${module.part}: ${module.partTitle}`,
    href: `/#part-${module.part}`,
  },
  { label: module.title, href: `/module/${module.slug}` },
];
---

<BaseLayout title={title} description={description}>
  <!-- Reading progress bar (visible in focus mode) -->
  <ReadingProgress client:load moduleSlug={module.slug} />

  <div class="mx-auto max-w-screen-2xl">
    <div class="flex min-h-[calc(100vh-4rem)]">
      <!-- Sidebar (hidden on mobile) -->
      <aside
        data-sidebar="left"
        class="hidden w-72 flex-shrink-0 border-r border-neutral-200 dark:border-dark-border lg:block"
      >
        <div class="sticky top-16 h-[calc(100vh-4rem)] overflow-y-auto p-4">
          <Sidebar currentModuleSlug={module.slug} />
        </div>
      </aside>

      <!-- Main content area -->
      <div class="flex flex-1 flex-col lg:flex-row" data-main-content>
        <!-- Content -->
        <article class="flex-1 px-4 py-8 lg:px-8">
          <div class="mx-auto max-w-3xl">
            <!-- Focus mode toggle -->
            <div class="mb-4 flex justify-end">
              <FocusModeToggle client:load />
            </div>

            <!-- Breadcrumbs -->
            <Breadcrumbs items={breadcrumbItems} />

            <!-- Lesson header -->
            <header class="mb-8 mt-4">
              <div
                class="flex flex-wrap items-center gap-2 text-sm text-neutral-600 dark:text-[#c9d1d9]"
              >
                <span class="badge-primary">Module {module.id}</span>
                <span>{module.duration}</span>
                <span class="text-neutral-300 dark:text-neutral-500">|</span>
                <span>{module.difficulty}</span>
                {
                  readingTime && (
                    <>
                      <span class="text-neutral-300 dark:text-neutral-500">
                        |
                      </span>
                      <span class="flex items-center gap-1">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="h-4 w-4"
                        >
                          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                        </svg>
                        {readingTime}
                      </span>
                    </>
                  )
                }
                {
                  exerciseTime && (
                    <>
                      <span class="text-neutral-300 dark:text-neutral-500">
                        |
                      </span>
                      <span class="flex items-center gap-1">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="h-4 w-4"
                        >
                          <path d="m18 16 4-4-4-4" />
                          <path d="m6 8-4 4 4 4" />
                          <path d="m14.5 4-5 16" />
                        </svg>
                        {exerciseTime}
                      </span>
                    </>
                  )
                }
              </div>
              <h1
                class="mt-3 text-3xl font-bold tracking-tight text-neutral-900 dark:text-[#e6edf3] lg:text-4xl"
              >
                {title}
              </h1>
              {
                description && (
                  <p class="mt-3 text-lg text-neutral-600 dark:text-[#c9d1d9]">
                    {description}
                  </p>
                )
              }
            </header>

            <!-- Progress indicator (client-side) -->
            <div class="mb-8">
              <ProgressTracker
                client:load
                moduleSlug={module.slug}
                variant="lesson"
              />
            </div>

            <!-- Mobile Table of Contents (shown only on mobile/tablet) -->
            {
              headings.length > 0 && (
                <MobileTableOfContents client:load headings={headings} />
              )
            }

            <!-- Lesson content with annotations -->
            <div class="prose-custom relative">
              <ContentAnnotations client:load moduleSlug={module.slug} />
              <slot />
            </div>

            <!-- Lesson navigation -->
            <LessonNavigation currentModuleId={module.id} />
          </div>
        </article>

        <!-- Table of Contents (hidden on mobile/tablet) -->
        {
          headings.length > 0 && (
            <aside
              data-sidebar="right"
              class="hidden w-64 flex-shrink-0 xl:block"
            >
              <div class="sticky top-16 p-4">
                <TableOfContents headings={headings} />
              </div>
            </aside>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Initialize Mermaid diagrams with beautiful themes
  import mermaid from "mermaid";

  // Beautiful theme configuration
  const lightThemeVariables = {
    // Modern gradient-friendly palette
    primaryColor: "#6366f1", // Indigo
    primaryTextColor: "#ffffff",
    primaryBorderColor: "#4f46e5",
    secondaryColor: "#f0abfc", // Pink/fuchsia
    secondaryTextColor: "#1e1b4b",
    secondaryBorderColor: "#d946ef",
    tertiaryColor: "#a5f3fc", // Cyan
    tertiaryTextColor: "#164e63",
    tertiaryBorderColor: "#06b6d4",
    // Lines and text
    lineColor: "#6b7280",
    textColor: "#374151",
    // Background
    background: "#ffffff",
    mainBkg: "#f8fafc",
    // Nodes
    nodeBorder: "#e5e7eb",
    nodeTextColor: "#1f2937",
    // Flowchart specific
    clusterBkg: "#f1f5f9",
    clusterBorder: "#cbd5e1",
    // State diagram
    labelColor: "#374151",
    edgeLabelBackground: "#ffffff",
  };

  const darkThemeVariables = {
    // Modern dark palette
    primaryColor: "#818cf8", // Lighter indigo for dark mode
    primaryTextColor: "#ffffff",
    primaryBorderColor: "#6366f1",
    secondaryColor: "#f0abfc",
    secondaryTextColor: "#faf5ff",
    secondaryBorderColor: "#e879f9",
    tertiaryColor: "#22d3ee",
    tertiaryTextColor: "#083344",
    tertiaryBorderColor: "#06b6d4",
    // Lines and text
    lineColor: "#9ca3af",
    textColor: "#e5e7eb",
    // Background
    background: "#0f0f10",
    mainBkg: "#18181b",
    // Nodes
    nodeBorder: "#3f3f46",
    nodeTextColor: "#f4f4f5",
    // Flowchart specific
    clusterBkg: "#27272a",
    clusterBorder: "#52525b",
    // State diagram
    labelColor: "#e5e7eb",
    edgeLabelBackground: "#27272a",
  };

  function initMermaid() {
    const isDark = document.documentElement.classList.contains("dark");

    mermaid.initialize({
      startOnLoad: false,
      theme: "base",
      securityLevel: "loose",
      fontFamily: "Inter, system-ui, sans-serif",
      flowchart: {
        curve: "basis",
        padding: 20,
        htmlLabels: true,
        useMaxWidth: true,
      },
      themeVariables: isDark ? darkThemeVariables : lightThemeVariables,
    });

    // Find and render mermaid elements (pre-mermaid strategy creates <pre class="mermaid">)
    const elements = document.querySelectorAll<HTMLPreElement>("pre.mermaid");
    if (elements.length > 0) {
      mermaid.run({ nodes: Array.from(elements) });
    }
  }

  // Initialize on load
  document.addEventListener("DOMContentLoaded", initMermaid);
  if (document.readyState !== "loading") {
    initMermaid();
  }

  // Re-initialize on Astro page transitions
  document.addEventListener("astro:after-swap", initMermaid);

  // Re-render on theme change
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.attributeName === "class") {
        // Reset mermaid elements for re-rendering
        document
          .querySelectorAll<HTMLPreElement>("pre.mermaid[data-processed]")
          .forEach((el) => {
            el.removeAttribute("data-processed");
            // Get original content from the SVG and restore it
            const svg = el.querySelector("svg");
            if (svg && el.dataset.originalContent) {
              el.innerHTML = el.dataset.originalContent;
            }
          });
        initMermaid();
      }
    });
  });

  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["class"],
  });

  // Store original content before mermaid processes it
  document.querySelectorAll<HTMLPreElement>("pre.mermaid").forEach((el) => {
    if (!el.dataset.originalContent) {
      el.dataset.originalContent = el.textContent || "";
    }
  });
</script>

<style>
  /* Custom prose overrides for lesson content */
  .prose-custom :global(h2) {
    @apply mt-10 scroll-mt-20;
  }

  .prose-custom :global(h3) {
    @apply mt-8 scroll-mt-20;
  }

  .prose-custom :global(pre) {
    @apply my-6;
  }

  .prose-custom :global(.mermaid),
  .prose-custom :global(picture[data-mermaid-diagram]),
  .prose-custom :global(p:has(> picture:only-child)) {
    @apply my-8;
  }

  /* Annotation system styles */
  .prose-custom {
    @apply pl-8;
  }

  .prose-custom :global(.annotatable-element) {
    @apply relative transition-colors duration-150;
  }

  .prose-custom :global(.annotatable-element:hover) {
    @apply bg-amber-50/50 dark:bg-amber-900/10;
  }
</style>
